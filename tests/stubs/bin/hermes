#!/usr/bin/env bash
# Test stub for the Hermes CLI: records argv and emulates the few commands install.sh reads.
# Without -p it acts on the host (default) home $FAKE_HOME; with -p P on $FAKE_HOME/profiles/P.
set -u
echo "hermes $*" >> "${STUB_LOG:?STUB_LOG must be set}"
home="${FAKE_HOME:?}"
if [[ "${1:-}" == "-p" ]]; then home="$FAKE_HOME/profiles/$2"; shift 2; fi
case "${1:-} ${2:-}" in
  "profile show") [[ -d "$FAKE_HOME/profiles/$3" ]] ;;
  "profile create") mkdir -p "$FAKE_HOME/profiles/$3/plugins" ;;
  "config path")
    if [[ -d "$home" ]]; then echo "$home/config.yaml"; else echo "Error: Profile does not exist."; fi ;;
  "config get") echo "Config key not set: $3"; exit 1 ;;
  "webhook list")  # like the real CLI: route names first, then plenty of detail lines
    grep -o "webhook subscribe herdr-[a-z0-9]*" "$STUB_LOG" | sed 's/webhook subscribe //' | sort -u
    for i in $(seq 20000); do echo "    detail line $i"; done ;;
  "webhook test") echo 'Response (200): {"status": "ignored"}' ;;
  "--version "*) echo "Hermes Agent (stub)" ;;
  *) : ;;
esac
