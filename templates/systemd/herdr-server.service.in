[Unit]
Description=Herdr server (telegram-harness)
After=network-online.target

[Service]
Type=simple
@USER_LINE@
Environment=HOME=@HOME@
# Agent panes inherit this environment: `claude`, `openspec` and `lean-ctx` must be on PATH.
Environment=PATH=@PATH@
ExecStart=@HERDR_BIN@ server
Restart=always
RestartSec=3

[Install]
WantedBy=@WANTED_BY@
